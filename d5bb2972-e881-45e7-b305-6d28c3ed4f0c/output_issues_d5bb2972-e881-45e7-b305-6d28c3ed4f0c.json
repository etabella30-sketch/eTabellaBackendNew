{
  "b17ae2b4-b671-4de9-9fc4-9ef62718f177": [
    {
      "timestamp": "09:01:05",
      "index": 16,
      "pageno": 1,
      "identity": "17",
      "text": "The second point on the agenda is the use of the"
    },
    {
      "timestamp": "09:01:10",
      "index": 17,
      "pageno": 1,
      "identity": "18",
      "text": "slides and some of the slides identified by parties'"
    },
    {
      "timestamp": "09:01:13",
      "index": 18,
      "pageno": 1,
      "identity": "19",
      "text": "respective counsel as being demonstrative exhibit, this"
    },
    {
      "timestamp": "09:01:18",
      "index": 19,
      "pageno": 1,
      "identity": "20",
      "text": "will be dealt with before we start this morning."
    }
  ],
  "3959c048-03ce-443e-884c-9345e7504a9d": [
    {
      "timestamp": "09:01:54",
      "index": 4,
      "pageno": 2,
      "identity": "30",
      "text": "Thank you, there are no other matters at this moment"
    },
    {
      "timestamp": "09:01:56",
      "index": 5,
      "pageno": 2,
      "identity": "31",
      "text": "to decide."
    },
    {
      "timestamp": "09:01:57",
      "index": 6,
      "pageno": 2,
      "identity": "32",
      "text": "PRESIDENT: Thank you, claimant, and very shortly the"
    },
    {
      "timestamp": "09:01:59",
      "index": 7,
      "pageno": 2,
      "identity": "33",
      "text": "tribunal will invite you to introduce all the members of"
    },
    {
      "timestamp": "09:02:02",
      "index": 8,
      "pageno": 2,
      "identity": "34",
      "text": "the delegation that is composed on my right-hand side."
    },
    {
      "timestamp": "09:02:09",
      "index": 9,
      "pageno": 2,
      "identity": "35",
      "text": "Respondent."
    }
  ],
  "ebc57285-fd98-4bc4-b627-daf9fbfc0a28": [
    {
      "timestamp": "09:04:18",
      "index": 15,
      "pageno": 3,
      "identity": "66",
      "text": "PRESIDENT: Thank you very much."
    },
    {
      "timestamp": "09:04:19",
      "index": 16,
      "pageno": 3,
      "identity": "67",
      "text": "Can you confirm, claimant, that none of the"
    },
    {
      "timestamp": "09:04:23",
      "index": 17,
      "pageno": 3,
      "identity": "68",
      "text": "witnesses who are going to be called are in attendance"
    },
    {
      "timestamp": "09:04:25",
      "index": 18,
      "pageno": 3,
      "identity": "69",
      "text": "this morning? On your side?"
    },
    {
      "timestamp": "09:04:28",
      "index": 19,
      "pageno": 3,
      "identity": "70",
      "text": "MR HAUGENEDER: I confirm that."
    },
    {
      "timestamp": "09:04:29",
      "index": 20,
      "pageno": 3,
      "identity": "71",
      "text": "PRESIDENT: Respondent?"
    }
  ],
  "91026af2-46f1-4e94-81f3-207432476e96": [
    {
      "timestamp": "09:02:39",
      "index": 18,
      "pageno": 2,
      "identity": "44",
      "text": "Thank you, madam president."
    },
    {
      "timestamp": "09:02:40",
      "index": 19,
      "pageno": 2,
      "identity": "45",
      "text": "On behalf of the claimant, PPD, we have Mr Lovro"
    },
    {
      "timestamp": "09:02:47",
      "index": 20,
      "pageno": 2,
      "identity": "46",
      "text": "Gasparac, we have Ms Tea Piacun and to my left Mr Ben"
    },
    {
      "timestamp": "09:02:57",
      "index": 21,
      "pageno": 2,
      "identity": "47",
      "text": "Holland. To my right Ms Jurgita Petkute,"
    }
  ],
  "73c88813-fce8-4e32-abe8-6eaa3cdb7a56": [
    {
      "timestamp": "11:02:17",
      "index": 2,
      "pageno": 62,
