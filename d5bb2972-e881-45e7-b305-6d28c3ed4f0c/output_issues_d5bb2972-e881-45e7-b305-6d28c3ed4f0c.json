  ],
  "e8a0d341-f101-4347-9a32-c1c42198dd89": [
    {
      "timestamp": "09:05:19",
      "index": 11,
      "pageno": 4,
      "identity": "87",
      "text": "PRESIDENT: Do you intend to have Mr Goeth participate in"
    },
    {
      "timestamp": "09:05:22",
      "index": 12,
      "pageno": 4,
      "identity": "88",
      "text": "the hearing?"
    },
    {
      "timestamp": "09:05:23",
      "index": 13,
      "pageno": 4,
      "identity": "89",
      "text": "MR TALANOV: Yes, not today. Starting from tomorrow."
    },
    {
      "timestamp": "09:05:47",
      "index": 14,
      "pageno": 4,
      "identity": "90",
      "text": "PRESIDENT: Is he in the hotel right now?"
    }
  ],
  "074936cb-1b23-4f0b-9691-2fb6fe9f6e9e": [
