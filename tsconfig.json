{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/global": [
        "libs/global/src"
      ],
      "@app/global/*": [
        "libs/global/src/*"
      ],
      "@app/feed-parse": [
        "libs/feed-parse/src"
      ],
      "@app/feed-parse/*": [
        "libs/feed-parse/src/*"
      ],
      "@app/edge-sync": [
        "libs/edge-sync/src"
      ],
      "@app/edge-sync/*": [
        "libs/edge-sync/src/*"
      ],
      "@app/rt-ingest": [
        "libs/rt-ingest/src"
      ],
      "@app/rt-ingest/*": [
        "libs/rt-ingest/src/*"
      ],
      "@app/edge-token": [
        "libs/edge-token/src"
      ],
      "@app/edge-token/*": [
        "libs/edge-token/src/*"
      ],
      "@app/api-kernel": [
        "libs/api-kernel/src"
      ],
      "@app/api-kernel/*": [
        "libs/api-kernel/src/*"
      ],
      "@app/api-contracts": [
        "libs/api-contracts/src"
      ],
      "@app/api-contracts/*": [
        "libs/api-contracts/src/*"
      ],
      "@app/permissions": [
        "libs/permissions/src"
      ],
      "@app/permissions/*": [
        "libs/permissions/src/*"
      ],
      "@app/rt-features": [
        "libs/rt-features/src"
      ],
      "@app/rt-features/*": [
        "libs/rt-features/src/*"
      ],
      "@app/platform-cloud": [
        "libs/platform-cloud/src"
      ],
      "@app/platform-cloud/*": [
        "libs/platform-cloud/src/*"
      ],
      "@assets/*": [
        "assets/*"
      ]
    }
  }
}
