# =====================================================================
#  eTabella RT local - settings
#
#  This is the TEMPLATE shipped with every release. On the first start run.bat copies it to
#  .env.production, which is yours: an update never replaces it.
#
#  Edit a value, save, then:  run.bat  >  [2] Start   (it restarts with the new values)
#  Lines starting with # are notes. No quotes, no spaces around "=".
#  There is no password or key in this file.
# =====================================================================

NODE_ENV=production

# ---------- This box ----------
# Name shown on the box page and on etabella.net (Admin > Venue boxes).
BOX_NAME=New venue box
# Time zone of the venue (IANA name), used for every time shown on the box.
TIME_ZONE=Asia/Kolkata

# ---------- Live server ----------
# The etabella server this box sends the transcript to.
LIVE_URL=https://etabella.net

# ---------- Box page ----------
# People in the room open  http://<this PC address>:<PORT>
PORT=4000

# How people sign in on the box page:
#   password = etabella.net email + password, typed on the box page (simple, like the old RT local)
#   cloud    = email on the box page, password on etabella.net (needs HTTPS=on)
SIGN_IN=password

# HTTPS=off : plain http on the PC address (no certificate, no hosts line).
# HTTPS=on  : https on the box host name. Needs a certificate (make-cert.ps1) and PORT=443.
HTTPS=off
SSL_CERT=./data/certs/fullchain.pem
SSL_KEY=./data/certs/privkey.pem

# ---------- Reporter (CAT feed) ----------
# Port the reporter's Eclipse connects to when it dials in to this PC ("Connect to server").
# The reporter's own IP address and port are NOT set here: they are set per session on
# etabella.net (Admin > Realtime > Start session), or by a super admin on the box page
# (gear menu > Realtime transmitter).
TCP_PORT=2600

# ---------- Who may open the box settings ----------
#   super-admin = super admins only (default)
#   case-admin  = also the case admin of a case on this box
SETTINGS_ACCESS=super-admin

# ---------- Service page (this PC only) ----------
# http://localhost:<CONSOLE_PORT>   0 = off
CONSOLE_PORT=2601

# ---------- Folders ----------
# DATA_DIR holds this box's identity and everything it recorded. Do not delete it.
DATA_DIR=./data
PUBLIC_DIR=./public
