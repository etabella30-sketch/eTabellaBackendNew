# =============================================================================
# Etabella local Docker stack — env template
# Copy this file to .env (in the same folder) and fill in any blank values.
# .env is gitignored. .env.example is committed.
# =============================================================================

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=etabella

# --- Redis ---
# Leave empty to run Redis without auth (matches local dev).
# If set, REDIS_URL in backend env must include the password.
REDIS_PASSWORD=

# --- MinIO (S3-compatible local store) ---
MINIO_USER=admin
MINIO_PASS=admin12345
MINIO_BUCKET=etabella

# --- DigitalOcean Spaces (source for rclone DO -> MinIO sync) ---
# These mirror the values in D:\eTabella final\etabella\.env.
# Real keys live in the gitignored .env, not here.
DO_ACCESS_KEY=
DO_SECRET_KEY=
DO_REGION=sgp1
DO_ENDPOINT=sgp1.digitaloceanspaces.com
DO_CDN_ENDPOINT=etabella.sgp1.cdn.digitaloceanspaces.com
DO_BUCKET=etabella

# rclone uses this to talk to MinIO. Default is the in-network HTTP endpoint.
# Switch to https://minio:9443 once HTTPS is added in a later phase.
MINIO_ENDPOINT=http://minio:9000

# --- SymmetricDS ---
# Leave LOCAL_ID blank to auto-generate a UUID on first start (persisted in
# symmetric-engines/node-id.txt). Set explicitly to inherit an existing
# registered node identity.
SYM_LOCAL_ID=
SYM_REG_URL=http://68.183.90.247:8080/sync/live-000
SYM_HOST_PORT=8085
